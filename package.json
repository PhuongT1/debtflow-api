{
  "name": "debtflow-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "setup:dev": "npm run db:migrate && npm run db:generate && npm run db:seed && npm run dev",
    "start": "node dist/src/main.js",
    "build": "npm run db:generate && nest build && tsc-alias -p tsconfig.json",
    "build:prod": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate --generator client",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:check": "npm run db:validate && npm run db:generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "import:parties": "tsx scripts/import-parties.ts",
    "docs:db": "prisma generate --generator markdown",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "docs:generate": "npm run build && npm run docs:api && npm run docs:db",
    "docs:check": "npm run docs:generate && test -z \"$(git status --porcelain -- docs/generated)\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:setup": "node scripts/ai-setup.mjs",
    "ai:check": "node scripts/ai-setup.mjs --check",
    "test:ai": "node --test scripts/ai-setup.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.32",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.29.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "prisma-markdown": "^4.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.5"
  }
}
