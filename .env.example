# Runtime mode; set it in the shell/deploy platform to select .env.<mode> (app.module.ts).
NODE_ENV=development

# Required PostgreSQL URL for API, seed and import (config/app.config.ts).
# Use a pooled endpoint when available; otherwise use the direct endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

# Optional direct URL for Prisma CLI migrations/schema work (prisma.config.ts).
# Must target the same database; defaults to DATABASE_URL when omitted.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

# Standalone HTTP port; default 4000. Swagger uses /docs on this port (main.ts).
PORT=4000

# Required token signing/verification secret, at least 24 characters (auth service/guard).
# Generate with openssl rand -base64 32; never commit real secrets.
JWT_SECRET="change-me-with-openssl-rand-base64-32"

# Access token lifetime; default 15m (auth service).
JWT_EXPIRES_IN="15m"

# Refresh token lifetime; default 7d, used by /api/auth/refresh (auth service).
JWT_REFRESH_EXPIRES_IN="7d"

# Allowed browser origins, comma-separated; default http://localhost:3000 (configure-app.ts).
CORS_ORIGIN="http://localhost:3000"
