{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": [
      {
        "include": "generated/prisma/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "common/swagger/swagger-auth.js",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "watchAssets": false
  }
}
