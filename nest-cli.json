{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "esmCompatible": true
        }
      }
    ],
    "assets": [
      {
        "include": "common/swagger/swagger-auth.js",
        "outDir": "dist",
        "watchAssets": true
      }
    ],
    "watchAssets": false
  },
  "exec": "node --import ./scripts/rewrite-build-aliases.mjs"
}
