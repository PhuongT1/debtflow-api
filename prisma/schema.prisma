generator client {
  provider = "prisma-client"
  moduleFormat = "esm"
  importFileExtension = "ts"
  output   = "../src/generated/prisma"
}

generator listQueryMetadata {
  provider = "node ./scripts/generate-list-query-metadata.mjs"
  output = "../src/generated/list-query"
}

generator responseModels {
  provider = "node ./scripts/generate-response-models.mjs"
  output   = "../src/generated/response-models"
  model    = "Party"
}

generator markdown {
  provider = "prisma-markdown"
  output   = "../docs/generated/database.md"
  title    = "DebtFlow Database"
  root     = "."
}

datasource db {
  provider = "postgresql"
}
