enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum CollectionStatus {
  NEW
  CONTACTED
  PROMISED
  DISPUTED
  ESCALATED
}

enum SalesChannel {
  STORE
  ONLINE
  WHOLESALE
}

/// A receivable (customer owes us) or payable (we owe a supplier) document. Remaining = originalAmount - paidAmount.
model Debt {
  id               String           @id @default(cuid())
  organizationId   String
  /// Generated per organization as CN-YYYYMM-NNNN.
  code             String
  type             DebtType
  partyId          String
  /// Staff member responsible for collecting this debt.
  assignedToId     String?
  title            String
  invoiceNo        String?
  orderNo          String?
  contractNo       String?
  poNo             String?
  description      String?
  originalAmount   Decimal          @db.Decimal(18, 2)
  /// Sum of payment allocations. Maintained by the payment workflow, never edited directly.
  paidAmount       Decimal          @default(0) @db.Decimal(18, 2)
  currency         String           @default("VND")
  salesChannel     SalesChannel?
  issueDate        DateTime
  /// Must not be earlier than issueDate. Drives overdue and aging calculations.
  dueDate          DateTime
  /// Payment lifecycle: OPEN -> PARTIAL -> PAID, or CANCELLED (only when no payment exists).
  status           DebtStatus       @default(OPEN)
  /// Collection workflow stage, independent from the payment status.
  collectionStatus CollectionStatus @default(NEW)
  nextFollowUpAt   DateTime?
  followUpNote     String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party      Party     @relation(fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignedTo User?     @relation("DebtAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]
  items      DebtItem[]

  @@unique([organizationId, code])
  @@index([organizationId, type, status])
  @@index([organizationId, partyId, status, type])
  @@index([status])
  @@index([collectionStatus])
  @@index([dueDate])
  @@index([nextFollowUpAt])
  @@index([partyId])
  @@index([assignedToId])
  @@index([salesChannel])
}

/// Line item of a debt. Product code, name, category and brand are copied so history survives catalog changes.
model DebtItem {
  id           String   @id @default(cuid())
  debtId       String
  /// Nullable: the product may be deleted or the line may be free text.
  productId    String?
  productCode  String?
  productName  String
  categoryName String?
  brandName    String?
  quantity     Decimal  @default(1) @db.Decimal(14, 3)
  unit         String   @default("Cái")
  unitPrice    Decimal  @db.Decimal(18, 2)
  lineAmount   Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([debtId])
  @@index([productId])
}
