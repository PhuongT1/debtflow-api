enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

/// Counterparty of a debt: a customer, a supplier, or both.
model Party {
  id           String   @id @default(cuid())
  organizationId String
  type         PartyType
  /// Optional business code, unique per organization.
  code         String?
  name         String
  /// Normalized text used by the party search (name, code, phone, ...).
  searchText   String   @default("")
  phone        String?
  email        String?
  taxCode      String?
  address      String?
  provinceCode String?
  provinceName String?
  address2     String?
  note         String?
  /// Maximum allowed outstanding receivable for this party.
  creditLimit  Decimal? @db.Decimal(18, 2)
  /// Soft delete flag. A party with unsettled debts cannot be deactivated.
  isActive     Boolean  @default(true)
  createdById  String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy  User?  @relation("PartyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?  @relation("PartyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  debts      Debt[]
  payments   Payment[] @relation("PartyPayments")
  imageUrl   String?

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, isActive, name, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Party_searchText_trgm_idx")
  @@index([organizationId, searchText])
  @@index([type])
  @@index([isActive])
  @@index([assignedToId])
  @@index([provinceCode])
}
