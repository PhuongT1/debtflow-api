enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Party {
  id           String   @id @default(cuid())
  organizationId String
  type         PartyType
  code         String?
  name         String
  phone        String?
  email        String?
  taxCode      String?
  address      String?
  provinceCode String?
  provinceName String?
  address2     String?
  note         String?
  creditLimit  Decimal? @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  createdById  String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy  User?  @relation("PartyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?  @relation("PartyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  debts      Debt[]
  payments   Payment[] @relation("PartyPayments")
  imageUrl   String?

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([type])
  @@index([isActive])
  @@index([assignedToId])
  @@index([provinceCode])
}
