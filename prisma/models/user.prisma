enum SystemRole {
  USER
  PLATFORM_OWNER
  PLATFORM_SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationKind {
  PERSONAL
  BUSINESS
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum OrganizationMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// Login identity. A user is global and gets business access only through an OrganizationMembership.
model User {
  id           String     @id @default(cuid())
  name         String
  /// Login identifier. Stored lower-cased and unique across all organizations.
  email        String     @unique
  phone        String?    @unique
  /// bcrypt hash. Never returned by the API.
  passwordHash String?
  /// Platform-level role. Tenant permissions come from OrganizationMembership.role instead.
  systemRole   SystemRole @default(USER)
  /// INACTIVE users cannot log in or refresh tokens.
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships          OrganizationMembership[]
  createdOrganizations Organization[] @relation("OrganizationCreatedBy")
  parties              Party[]    @relation("PartyCreatedBy")
  assignedParties      Party[]    @relation("PartyAssignedTo")
  debts                Debt[]     @relation("DebtCreatedBy")
  assignedDebts        Debt[]     @relation("DebtAssignedTo")
  payments             Payment[]  @relation("PaymentCreatedBy")
  auditLogs            AuditLog[] @relation("AuditActor")
}

/// Tenant. Every business table (Party, Debt, Payment, Category, Brand, Product, AuditLog) carries organizationId.
model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  /// PERSONAL (single user) or BUSINESS (team).
  kind        OrganizationKind
  /// Only ACTIVE organizations can be used to log in or switch context.
  status      OrganizationStatus @default(ACTIVE)
  taxCode     String?
  address     String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy   User? @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships OrganizationMembership[]
  parties     Party[]
  debts       Debt[]
  payments    Payment[]
  auditLogs   AuditLog[]
  categories  Category[]
  brands      Brand[]
  products    Product[]

  @@index([status])
  @@index([kind])
}

/// Links a User to an Organization with a role. The JWT carries organizationId, membershipId and role.
model OrganizationMembership {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String
  /// Authorization role inside this organization (see docs/reference/business-rules.md).
  role           OrganizationRole             @default(VIEWER)
  /// Only ACTIVE memberships can authenticate.
  status         OrganizationMembershipStatus @default(INVITED)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}
