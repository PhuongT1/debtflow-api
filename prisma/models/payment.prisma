enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

/// A voucher (receipt or disbursement) from or to one party. It is split across debts through PaymentAllocation.
model Payment {
  id          String        @id @default(cuid())
  organizationId String
  partyId     String
  /// RECEIVABLE = money received from a customer, PAYABLE = money paid to a supplier.
  type        DebtType
  /// Total voucher amount. Equals the sum of its allocations.
  amount      Decimal       @db.Decimal(18, 2)
  paidAt      DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  referenceNo String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party       Party               @relation("PartyPayments", fields: [partyId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  createdBy   User?               @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, partyId, type, paidAt])
  @@index([paidAt])
}

/// The portion of a Payment applied to one Debt. Deleting a payment cascades here and rolls back the debts.
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  debtId    String
  /// Amount applied to this debt. Cannot exceed the debt's remaining balance.
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Restrict)

  @@unique([paymentId, debtId])
  @@index([debtId])
}
