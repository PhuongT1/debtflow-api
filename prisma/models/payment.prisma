enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  organizationId String
  partyId     String
  type        DebtType
  amount      Decimal       @db.Decimal(18, 2)
  paidAt      DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  referenceNo String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party       Party               @relation("PartyPayments", fields: [partyId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  createdBy   User?               @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, partyId, type, paidAt])
  @@index([paidAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  debtId    String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Restrict)

  @@unique([paymentId, debtId])
  @@index([debtId])
}
